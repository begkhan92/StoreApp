@page
@model StoreApp.Web.Pages.Products.IndexModel
@{ ViewData["Title"] = T["Товары"]; }
<h1>@T["Товары"]</h1>
<input type="search" name="q" value="@Model.Q" class="search" autofocus autocomplete="off"
       placeholder="@T["Название, артикул или штрихкод"]"
       hx-get="@Url.Page("Index")" hx-trigger="input changed delay:150ms, search" hx-target="#rows" />
<table class="tbl">
    <thead><tr><th>@T["Артикул"]</th><th>@T["Название"]</th><th class="num">@T["Цена"]</th><th class="num">@T["Остаток"]</th></tr></thead>
    <tbody id="rows"><partial name="_ProductRows" model="Model" /></tbody>
</table>

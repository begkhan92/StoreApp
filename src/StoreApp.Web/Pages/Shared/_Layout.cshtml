@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Antiforgery
@{
    var authed = User.Identity?.IsAuthenticated == true;
    var staff = User.IsInRole(Roles.Owner) || User.IsInRole(Roles.Manager);
    var owner = User.IsInRole(Roles.Owner);
}
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — @Store.Current.StoreName</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.4/dist/htmx.min.js" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.8/dist/cdn.min.js" defer></script>
</head>
<body class="@(authed ? "" : "auth")"
      hx-headers='{"RequestVerificationToken":"@Antiforgery.GetAndStoreTokens(Context).RequestToken"}'
      data-err="@T["Ошибка. Попробуйте ещё раз."]">
    @if (authed)
    {
        <aside class="side">
            <div class="brand">@Store.Current.StoreName</div>
            <nav>
                <a href="/">@T["Обзор"]</a>
                <a href="/Products">@T["Товары"]</a>
                @if (staff)
                {
                    <a href="/Admin/Audit">@T["Журнал изменений"]</a>
                }
                @if (owner)
                {
                    <a href="/Admin/Settings">@T["Настройки"]</a>
                }
            </nav>
            <partial name="_Lang" />
            <form method="post" asp-page="/Account/Logout" class="who">
                <span>@User.Identity!.Name</span>
                <button type="submit">@T["Выйти"]</button>
            </form>
        </aside>
    }
    <main class="main">
        @if (!authed)
        {
            <partial name="_Lang" />
        }
        @RenderBody()
    </main>
    <script>
        // htmx ignores 4xx/5xx responses by default; the cashier must see that something failed.
        document.addEventListener('htmx:responseError', function () { alert(document.body.dataset.err); });
        document.addEventListener('htmx:sendError', function () { alert(document.body.dataset.err); });
    </script>
</body>
</html>